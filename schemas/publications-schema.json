{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publications",
  "description": "The lab's publication list shown on the website.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/publication"
  },
  "$defs": {
    "publication": {
      "type": "object",
      "description": "A single publication.",
      "properties": {
        "title": {
          "description": "Title of the publication.",
          "type": "string"
        },
        "date": {
          "description": "Publication date in YYYY-MM-DD format.",
          "type": "string"
        },
        "doi": {
          "description": "DOI URL of the publication.",
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "description": "Display names of the publication's authors.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preprint": {
          "description": "Whether the publication is still an unreviewed preprint.",
          "type": "boolean"
        }
      },
      "required": ["title", "date", "doi", "authors", "preprint"],
      "additionalProperties": false
    }
  }
}
